{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-hitesh-labs"
		},
		"ls_azure_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_azure_adls'"
		},
		"ls_azure_sql_db_raw_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azure_sql_db_raw'"
		},
		"ls_blob_storage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_blob_storage'"
		},
		"ls_stg_retails_analytics_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_stg_retails_analytics'"
		},
		"ls_azure_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stgretailanalyticsdev.dfs.core.windows.net/"
		},
		"ls_azure_sql_db_raw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "hitesh-sqlserver.database.windows.net"
		},
		"ls_azure_sql_db_raw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_hitesh_adf_raw"
		},
		"ls_azure_sql_db_raw_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "hiteshadmin"
		},
		"ls_az_key_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-snf-adf.vault.azure.net/"
		},
		"ls_snowflake_raw_dev_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "RETAIL_ANALYTICS_RAW_DEV"
		},
		"ls_snowflake_raw_dev_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "ADF_DEV_ROLE"
		},
		"ls_snowflake_raw_dev_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "JSUZVOC-PR12523.snowflakecomputing.com"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-hitesh-labs_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_azure_adls_accountKey": {
						"value": "[parameters('ls_azure_adls_accountKey')]"
					},
					"ls_azure_sql_db_raw_password": {
						"value": "[parameters('ls_azure_sql_db_raw_password')]"
					},
					"ls_blob_storage_connectionString": {
						"value": "[parameters('ls_blob_storage_connectionString')]"
					},
					"ls_stg_retails_analytics_connectionString": {
						"value": "[parameters('ls_stg_retails_analytics_connectionString')]"
					},
					"ls_azure_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_azure_adls_properties_typeProperties_url')]"
					},
					"ls_azure_sql_db_raw_properties_typeProperties_server": {
						"value": "[parameters('ls_azure_sql_db_raw_properties_typeProperties_server')]"
					},
					"ls_azure_sql_db_raw_properties_typeProperties_database": {
						"value": "[parameters('ls_azure_sql_db_raw_properties_typeProperties_database')]"
					},
					"ls_azure_sql_db_raw_properties_typeProperties_userName": {
						"value": "[parameters('ls_azure_sql_db_raw_properties_typeProperties_userName')]"
					},
					"ls_az_key_vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_az_key_vault_properties_typeProperties_baseUrl')]"
					},
					"ls_snowflake_raw_dev_properties_typeProperties_database": {
						"value": "[parameters('ls_snowflake_raw_dev_properties_typeProperties_database')]"
					},
					"ls_snowflake_raw_dev_properties_typeProperties_role": {
						"value": "[parameters('ls_snowflake_raw_dev_properties_typeProperties_role')]"
					},
					"ls_snowflake_raw_dev_properties_typeProperties_host": {
						"value": "[parameters('ls_snowflake_raw_dev_properties_typeProperties_host')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-hitesh-labs_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-hitesh-labs_ArmTemplate_0')]"
			]
		}
	]
}