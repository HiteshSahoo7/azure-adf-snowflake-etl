{
	"name": "pl_copy_csv",
	"properties": {
		"activities": [
			{
				"name": "copy csv",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_adls_csv_source",
						"type": "DatasetReference",
						"parameters": {
							"container_name": {
								"value": "@pipeline().parameters.p_source_container",
								"type": "Expression"
							},
							"folder_path": {
								"value": "@pipeline().parameters.p_source_folder",
								"type": "Expression"
							},
							"file_name": {
								"value": "@pipeline().parameters.p_file_name",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_csv_sink",
						"type": "DatasetReference",
						"parameters": {
							"container_name": {
								"value": "@pipeline().parameters.p_sink_container",
								"type": "Expression"
							},
							"folder_path": {
								"value": "@pipeline().parameters.p_sink_folder",
								"type": "Expression"
							},
							"file_name": {
								"value": "@concat(pipeline().parameters.p_file_name,utcNow())",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"p_source_container": {
				"type": "string"
			},
			"p_source_folder": {
				"type": "string"
			},
			"p_file_name": {
				"type": "string"
			},
			"p_sink_container": {
				"type": "string"
			},
			"p_sink_folder": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Common"
		},
		"annotations": []
	}
}